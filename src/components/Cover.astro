---
// A post's cover, drawn from its own numbers: columns with the one that matters in green, or one
// number on the brand's green, its trail growing behind it. Drawn in the list of posts, and larger
// at the top of the post.
import { bar, type Post } from "../lib/blog";

interface Props {
  cover: Post["data"]["cover"];
  large?: boolean;
}

const { cover, large = false } = Astro.props;
---

{Array.isArray(cover) ? (
  <div class:list={["cover", { large }]} aria-hidden="true" data-grow>
    {cover.map((column) => (
      <div>
        <b>{column.text ?? column.value.toFixed(2).replace(/^0/, "")}</b>
        <Fragment set:html={bar(column.value, "up", column.best)} />
        <small>{column.label}</small>
      </div>
    ))}
  </div>
) : (
  <div class:list={["cover", "number", { large }]} aria-hidden="true" data-grow>
    <small>{cover.label}</small>
    <span class="figure">
      <span class="trail">
        <i />
        <i />
        <i />
        <i />
      </span>
      <b>
        {cover.number}
        {cover.unit && <em>{cover.unit}</em>}
      </b>
    </span>
    <span class="line">{cover.line}</span>
  </div>
)}
