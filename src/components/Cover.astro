---
// A post's cover, drawn from its own numbers: columns with the one that matters in green; one
// number on the brand's green, its trail growing behind it; or one number as a slice of a whole,
// framed at the end of the whole and opened in a panel to show what it holds. Drawn in the list of
// posts, and larger at the top of the post.
import { bar, split, strip, type Post } from "../lib/blog";

interface Props {
  cover: Post["data"]["cover"];
  large?: boolean;
}

const { cover, large = false } = Astro.props;
const count = (value: number) => value.toLocaleString("en-US");
---

{Array.isArray(cover) ? (
  <div class:list={["cover", { large }]} aria-hidden="true" data-grow>
    {cover.map((column) => (
      <div>
        <b>{column.text ?? column.value.toFixed(2).replace(/^0/, "")}</b>
        <Fragment set:html={bar(column.value, "up", column.best)} />
        <small>{column.label}</small>
      </div>
    ))}
  </div>
) : "slice" in cover ? (
  <div class:list={["cover", "slice", { large }]} aria-hidden="true" data-grow>
    <small>{cover.label}</small>
    <span class="top">
      <span class="figure">
        <b>{count(cover.slice.value)}</b>
        <span class="line">{cover.slice.line}</span>
      </span>
      <span class="inside">
        <span class="title">{cover.slice.title}</span>
        <Fragment set:html={split(cover.slice.parts.map((part) => part.value))} />
        <span class="parts">
          {cover.slice.parts.map((part) => (
            <span>
              <i />
              {part.label}
              <b>{count(part.value)}</b>
            </span>
          ))}
        </span>
      </span>
    </span>
    <Fragment set:html={strip(cover.slice.value / cover.whole.value, large)} />
    <span class="whole">
      {count(cover.whole.value)} {cover.whole.line}
    </span>
  </div>
) : (
  <div class:list={["cover", "number", { large }]} aria-hidden="true" data-grow>
    <small>{cover.label}</small>
    <span class="figure">
      <span class="trail">
        <i />
        <i />
        <i />
        <i />
      </span>
      <b>
        {cover.number}
        {cover.unit && <em>{cover.unit}</em>}
      </b>
    </span>
    <span class="line">{cover.line}</span>
  </div>
)}
