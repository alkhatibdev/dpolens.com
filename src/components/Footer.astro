---
import Logo from "../assets/brand/dpolens-logo.svg";
import { FOOTER, SITE } from "../lib/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="grid">
    <div class="about">
      <Logo width={119} height={26} />
      <p>{SITE.tagline}.</p>
      <a class="repo" href={SITE.repo}>
        <Icon name="github" />
        <span>{SITE.repoName}</span>
      </a>
    </div>
    {FOOTER.map((column) => (
      <div>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.name}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="base">
    <span>© {year} DPOLens · Apache-2.0</span>
    <span>DPOLens finds the law. It is not legal advice.</span>
    <a href={`mailto:${SITE.contact}`}>{SITE.contact}</a>
  </div>
</footer>

<style>
  .foot {
    padding: 56px var(--gutter) 30px;
    border-top: 1px solid var(--color-line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 24em;
    font-size: 14.5px;
    color: var(--color-muted);
  }
  .about > svg {
    align-self: flex-start;
    height: 26px;
    width: auto;
  }
  .repo {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .repo:hover {
    color: var(--color-brand);
  }
  h2 {
    margin-bottom: 12px;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 14.5px;
  }
  ul a {
    color: var(--color-ink-2);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--color-brand);
  }
  .base {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    font-size: 13.5px;
    color: var(--color-muted);
  }
  .base a {
    color: inherit;
    text-decoration: none;
  }
  .base a:hover {
    color: var(--color-ink);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .foot {
      padding-top: 44px;
      padding-bottom: 26px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
