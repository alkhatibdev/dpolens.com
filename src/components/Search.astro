---
import Icon from "./Icon.astro";
---

<dialog class="search" id="search" aria-label="Search dpolens.com">
  <div class="box">
    <div class="field">
      <Icon name="search" size={18} />
      <input
        id="search-q"
        type="search"
        aria-label="Search dpolens.com"
        placeholder="Search dpolens.com"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>Esc</kbd>
    </div>
    <div class="results" role="listbox" aria-label="Results"></div>
    <div class="hints" aria-hidden="true">
      <span>↑ ↓ to move</span>
      <span>Enter to open</span>
      <span>Esc to close</span>
    </div>
  </div>
</dialog>

<script>
  interface Result {
    url: string;
    meta: { title?: string };
    excerpt: string;
  }
  interface Pagefind {
    options(options: Record<string, unknown>): Promise<void>;
    debouncedSearch(
      query: string,
      options?: Record<string, unknown>,
      wait?: number,
    ): Promise<{ results: { data(): Promise<Result> }[] } | null>;
  }

  const dialog = document.querySelector<HTMLDialogElement>("#search")!;
  const input = dialog.querySelector<HTMLInputElement>("input")!;
  const out = dialog.querySelector<HTMLElement>(".results")!;
  let pagefind: Promise<Pagefind> | undefined;
  let hits: Result[] = [];
  let at = 0;

  // The index is written by Pagefind after the build, so it is loaded only when somebody searches.
  const pagefindScript = "/pagefind/pagefind.js";
  const load = () => {
    pagefind ??= import(/* @vite-ignore */ pagefindScript).then(async (module: Pagefind) => {
      await module.options({ excerptLength: 18 });
      return module;
    });
    return pagefind;
  };

  const note = (text: string) => {
    out.replaceChildren(Object.assign(document.createElement("p"), { textContent: text }));
  };

  const render = () => {
    if (!hits.length) return note("Nothing on dpolens.com has those words.");
    out.replaceChildren(
      ...hits.map((hit, index) => {
        const link = document.createElement("a");
        link.href = hit.url.replace(/(\/index)?\.html$/, "") || "/";
        link.setAttribute("role", "option");
        link.setAttribute("aria-selected", String(index === at));
        const title = Object.assign(document.createElement("span"), {
          textContent: hit.meta.title ?? link.pathname,
        });
        const excerpt = document.createElement("small");
        // Pagefind escapes the page's text and marks the matched words with <mark>.
        excerpt.innerHTML = hit.excerpt;
        link.append(title, excerpt);
        return link;
      }),
    );
    out.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: "nearest" });
  };

  const run = async () => {
    const query = input.value.trim();
    if (!query) {
      hits = [];
      return note("Type a word or two.");
    }
    try {
      const search = await (await load()).debouncedSearch(query, {}, 150);
      if (!search) return; // A newer query replaced this one.
      hits = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
      at = 0;
      render();
    } catch {
      note("Search works on the built site: npm run build, then npm run preview.");
    }
  };

  const openSearch = (query = "") => {
    input.value = query;
    hits = [];
    dialog.showModal();
    input.focus();
    run();
  };

  input.addEventListener("input", run);
  input.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "ArrowUp") {
      event.preventDefault();
      const step = event.key === "ArrowDown" ? 1 : -1;
      at = Math.min(Math.max(at + step, 0), Math.max(hits.length - 1, 0));
      render();
    } else if (event.key === "Enter" && hits[at]) {
      event.preventDefault();
      out.querySelector<HTMLAnchorElement>('[aria-selected="true"]')?.click();
    }
  });
  // A click on the dimmed page around the box closes it.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  document.querySelectorAll("[data-search-open]").forEach((button) => {
    button.addEventListener("click", () => openSearch());
  });
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (!dialog.open) openSearch();
    }
  });
  // Another part of the page, like the 404's search field, can open it with its own words.
  document.addEventListener("dpolens:search", (event) => {
    openSearch((event as CustomEvent<string>).detail);
  });
</script>

<style>
  .search {
    width: 620px;
    max-width: calc(100vw - 32px);
    margin: 72px auto auto;
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: var(--color-white);
    color: var(--color-ink);
    box-shadow: 0 30px 80px -20px rgb(17 22 19 / 0.5);
  }
  .search::backdrop {
    background: rgb(17 22 19 / 0.3);
  }
  .box {
    max-height: min(520px, calc(100dvh - 120px));
    display: flex;
    flex-direction: column;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
  }
  .field input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    padding: 16px 0;
    font: 16px var(--font-sans);
    color: var(--color-ink);
  }
  .field input::-webkit-search-cancel-button {
    display: none;
  }
  .field kbd {
    font-size: 12px;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--color-line);
    padding: 1px 6px;
  }
  .results {
    overflow: auto;
    padding: 6px;
    display: flex;
    flex-direction: column;
  }
  .results :global(a) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 12px;
    border-radius: 10px;
    text-decoration: none;
  }
  .results :global(a span) {
    font-size: 15px;
    font-weight: 500;
  }
  .results :global(a small) {
    font-size: 13px;
    color: var(--color-muted);
  }
  .results :global(mark) {
    background: var(--color-mint);
    color: inherit;
  }
  .results :global(a[aria-selected="true"]),
  .results :global(a:hover) {
    background: var(--color-brand-soft);
  }
  .results :global(p) {
    padding: 14px 12px;
    font-size: 14px;
    color: var(--color-muted);
  }
  .hints {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    padding: 9px 14px;
    border-top: 1px solid var(--color-line);
    background: var(--color-panel);
    font-size: 12px;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .search {
      margin-top: 16px;
    }
    .hints {
      display: none;
    }
  }
</style>
