---
// The home page's opening: the promise, and a session in an AI assistant that cites the law.
import Icon from "../Icon.astro";
import { formatDate } from "../../lib/laws";
import { getLaws } from "../../lib/packs";
import { SITE } from "../../lib/site";

// The session quotes GDPR at the version the site carries.
const gdpr = (await getLaws()).find((law) => law.slug === "gdpr")!;
const inForce = formatDate(gdpr.effectiveDate);
---

<section class="v-hero" aria-labelledby="home-h1">
  <div class="v-hero-text">
    <h1 class="h1" id="home-h1">
      Privacy law your AI assistant <span class="mark">can cite</span>
    </h1>
    <p class="lede">
      Before your AI assistant writes code that touches personal data, it checks your policies and
      the law, and cites them.
    </p>
    <div class="btns">
      <a class="btn main" href="#community">
        Try the community version
      </a>
      <a class="btn line" href={SITE.repo}>
        <Icon name="github" size={17} />
        Self-host
      </a>
    </div>
  </div>
  <div class="v-scene-wrap" data-scene="home">
    <div class="v-scene">
      <div class="v-panel" id="home-p-as" data-times="1700,1000,700,700,700,900,5200">
        <div class="v-bar" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <span>Claude Code</span>
        </div>
        <div class="v-as">
          <ol class="v-flow" aria-label="What happens">
            <li class="v-node" data-active="0">
              <span class="ico">
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="4" y="6.5" width="12" height="9.5" rx="2.5" />
                  <path d="M10 3.5v3M7.5 11h.01M12.5 11h.01" />
                </svg>
              </span>
              <span>
                <b>
                  <span class="long">Your AI assistant</span>
                  <span class="short">AI assistant</span>
                </b>
                <small>Claude Code</small>
              </span>
              <i class="drip" aria-hidden="true"></i>
            </li>
            <li class="v-node" data-active="1">
              <span class="ico">
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 4.5C3 3.7 3.7 3 4.5 3H9v14H4.5c-.8 0-1.5-.7-1.5-1.5v-11Z" />
                  <path d="M17 4.5c0-.8-.7-1.5-1.5-1.5H11v14h4.5c.8 0 1.5-.7 1.5-1.5v-11Z" />
                </svg>
              </span>
              <span>
                <b>
                  <span class="long">DPOLens skill</span>
                  <span class="short">Skill</span>
                </b>
                <small>loaded</small>
              </span>
              <i class="drip" aria-hidden="true"></i>
            </li>
            <li class="v-node" data-active="2,3,4,5">
              <span class="ico">
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="14" height="6" rx="1.5" />
                  <rect x="3" y="11" width="14" height="6" rx="1.5" />
                  <path d="M6 6h.01M6 14h.01" />
                </svg>
              </span>
              <span>
                <b>
                  <span class="long">MCP server</span>
                  <span class="short">MCP</span>
                </b>
                <small>4 calls</small>
              </span>
              <i class="drip" aria-hidden="true"></i>
            </li>
            <li class="v-node" data-active="2,3,4,5">
              <span class="ico">
                <svg
                  aria-hidden="true"
                  width="18"
                  height="18"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M10 3v14M5 17h10" />
                  <path d="M3 7h14M3 7l-1.5 4.5a2.5 2.5 0 0 0 5 0L5 7M15 7l-1.5 4.5a2.5 2.5 0 0 0 5 0L17 7" />
                </svg>
              </span>
              <span>
                <b>
                  <span class="long">The law</span>
                  <span class="short">Law</span>
                </b>
                <small>GDPR {gdpr.version}</small>
              </span>
              <i class="drip" aria-hidden="true"></i>
            </li>
            <li class="v-node" data-active="6">
              <span class="ico">
                <Icon name="check" size={18} />
              </span>
              <span>
                <b>
                  <span class="long">Cited answer</span>
                  <span class="short">Answer</span>
                </b>
                <small>with clause keys</small>
              </span>
              <i class="drip" aria-hidden="true"></i>
            </li>
          </ol>
          <div class="v-log" aria-live="off">
            <div class="v-ask" data-step="0">
              ❯ <span class="typed">How long can we keep a deleted user’s data under GDPR?</span>
            </div>
            <div class="v-step" data-step="1">
              <span class="dot">⏺</span>
              <span class="tool">Skill(dpolens:dpolens)</span>
              <span class="arg">loaded</span>
            </div>
            <div class="v-step" data-step="2">
              <span class="dot">⏺</span>
              <span class="tool">dpolens · search_policies</span>
              <span class="arg">“deleted user data retention”</span>
            </div>
            <div class="v-step" data-step="3">
              <span class="dot">⏺</span>
              <span class="tool">dpolens · get_clause</span>
              <span class="arg">gdpr:art-17:para-1</span>
            </div>
            <div class="v-step" data-step="4">
              <span class="dot">⏺</span>
              <span class="tool">dpolens · get_clause</span>
              <span class="arg">gdpr:art-17:para-3</span>
            </div>
            <div class="v-step" data-step="5">
              <span class="dot">⏺</span>
              <span class="tool">dpolens · get_clause</span>
              <span class="arg">gdpr:art-5:para-1:pt-e</span>
            </div>
            <div class="v-answer" data-step="6">
              GDPR sets no fixed number of days. Once an account is deleted, its data is erased
              “without undue delay” <span class="kc">gdpr:art-17:para-1</span>, except what an
              exception covers <span class="kc">gdpr:art-17:para-3</span>, and is kept no longer
              than necessary <span class="kc">gdpr:art-5:para-1:pt-e</span>.
              <small>
                Quotes from GDPR version {gdpr.version}, in force since {inForce}.
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Each scene plays its steps in turn, waiting as long as data-times says after each, then starts again.
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timers = new Map<HTMLElement, ReturnType<typeof setTimeout>>();
  const show = (panel: HTMLElement, step: number) => {
    panel
      .querySelectorAll<HTMLElement>("[data-step]")
      .forEach((element) => element.classList.toggle("on", Number(element.dataset.step) <= step));
    panel.querySelectorAll<HTMLElement>("[data-active]").forEach((element) => {
      const steps = element.dataset.active!.split(",").map(Number);
      element.classList.toggle("active", steps.includes(step));
      element.classList.toggle("done", Math.max(...steps) < step);
    });
  };
  const play = (panel: HTMLElement) => {
    clearTimeout(timers.get(panel));
    const times = panel.dataset.times!.split(",").map(Number);
    if (still) return show(panel, times.length);
    let step = 0;
    const tick = () => {
      show(panel, step);
      const wait = times[step];
      step = step + 1 < times.length ? step + 1 : -1;
      if (step === -1) {
        timers.set(
          panel,
          setTimeout(() => {
            show(panel, -1);
            step = 0;
            timers.set(panel, setTimeout(tick, 500));
          }, wait),
        );
      } else {
        timers.set(panel, setTimeout(tick, wait));
      }
    };
    show(panel, -1);
    timers.set(panel, setTimeout(tick, 300));
  };
  // The scene plays when it comes into view.
  document.querySelectorAll<HTMLElement>("[data-scene]").forEach((scene) => {
    const panel = scene.querySelector<HTMLElement>(".v-panel")!;
    const watch = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        play(panel);
        watch.disconnect();
      },
      { threshold: 0.3 },
    );
    watch.observe(scene);
  });
</script>
