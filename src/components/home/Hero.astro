---
// The home page's opening: the promise, and the product at work in two scenes.
import Icon from "../Icon.astro";
import { formatDate } from "../../lib/laws";
import { getLaws } from "../../lib/packs";
import { SITE } from "../../lib/site";

// The scenes quote GDPR at the version the site carries.
const gdpr = (await getLaws()).find((law) => law.slug === "gdpr")!;
const inForce = formatDate(gdpr.effectiveDate);
