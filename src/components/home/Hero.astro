<script>
  // Each scene plays its steps in turn, waiting as long as data-times says after each, then starts again.
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const timers = new Map<HTMLElement, ReturnType<typeof setTimeout>>();
  const show = (panel: HTMLElement, step: number) => {
    panel
      .querySelectorAll<HTMLElement>("[data-step]")
      .forEach((element) => element.classList.toggle("on", Number(element.dataset.step) <= step));
    panel.querySelectorAll<HTMLElement>("[data-active]").forEach((element) => {
      const steps = element.dataset.active!.split(",").map(Number);
      element.classList.toggle("active", steps.includes(step));
      element.classList.toggle("done", Math.max(...steps) < step);
    });
  };
  const play = (panel: HTMLElement) => {
    clearTimeout(timers.get(panel));
    const times = panel.dataset.times!.split(",").map(Number);
    if (still) return show(panel, times.length);
    let step = 0;
    const tick = () => {
      show(panel, step);
      const wait = times[step];
      step = step + 1 < times.length ? step + 1 : -1;
      if (step === -1) {
        timers.set(
          panel,
          setTimeout(() => {
            show(panel, -1);
            step = 0;
            timers.set(panel, setTimeout(tick, 500));
          }, wait),
        );
      } else {
        timers.set(panel, setTimeout(tick, wait));
      }
    };
    show(panel, -1);
    timers.set(panel, setTimeout(tick, 300));
  };
  document.querySelectorAll<HTMLElement>("[data-scene]").forEach((scene) => {
    const tabs = [...scene.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")!)!);
    const select = (index: number) => {
      tabs.forEach((tab, i) => tab.setAttribute("aria-selected", String(i === index)));
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        if (i !== index) clearTimeout(timers.get(panel));
      });
      play(panels[index]);
    };
    tabs.forEach((tab, index) => tab.addEventListener("click", () => select(index)));
    // The scene starts when it comes into view.
    const watch = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        select(
          Math.max(
            0,
            tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true"),
          ),
        );
        watch.disconnect();
      },
      { threshold: 0.3 },
    );
    watch.observe(scene);
  });
</script>
