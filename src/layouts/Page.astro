---
import "../styles/site.css";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import Seo from "../components/Seo.astro";
import { SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  fullTitle?: boolean;
  canonical?: boolean;
  jsonLd?: Record<string, unknown>;
  published?: Date;
  /** Whether site search lists this page. */
  searchable?: boolean;
  /** What search results call the part of the site the page is in: Docs, Laws, Blog. */
  section?: string;
  /** The language of the page's own content. The site's menus stay English. */
  lang?: string;
  /** The same page in its other languages, for search engines. */
  alternates?: { lang: string; href: string }[];
}

const { searchable = true, section, lang = "en", alternates = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...seo} />
    <Font
      cssVariable="--font-sans"
      preload={[
        { subset: "latin", weight: 400 },
        { subset: "latin", weight: 600 },
      ]}
    />
    <Font cssVariable="--font-mono" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="DPOLens blog" href="/blog/rss.xml" />
    <meta name="theme-color" content="#ffffff" />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, SITE.origin)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="col" lang={lang === "en" ? undefined : "en"}>
      <Header />
      <main
        id="main"
        data-pagefind-body={searchable ? "" : undefined}
        data-pagefind-meta={section ? `section:${section}` : undefined}
      >
        <slot />
      </main>
      <Footer />
    </div>
    <Search />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-white);
    text-decoration: none;
  }
  .skip:focus {
    top: 16px;
  }
</style>
