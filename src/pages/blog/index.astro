---
import "../../styles/blog.css";
import Band from "../../components/Band.astro";
import Cover from "../../components/Cover.astro";
import Grow from "../../components/Grow.astro";
import Icon from "../../components/Icon.astro";
import Page from "../../layouts/Page.astro";
import { AUTHOR, getPosts, postPath, shortDate } from "../../lib/blog";
import { SITE } from "../../lib/site";

const posts = await getPosts();
const title = "Blog";
const lede = "News, updates, and notes from building DPOLens.";
const description = `${lede} By ${AUTHOR.name}.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${SITE.name} blog`,
  description,
  url: `${SITE.origin}/blog`,
  author: { "@type": "Person", name: AUTHOR.name, url: AUTHOR.url },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    datePublished: post.data.date.toISOString().slice(0, 10),
    url: `${SITE.origin}${postPath(post)}`,
  })),
};
---

<Page title={title} description={description} jsonLd={jsonLd} section="Blog">
  <header class="intro center">
    <h1 class="h1">{title}</h1>
    <p class="lede">{lede}</p>
    <div class="btns">
      <a class="btn line" href="/blog/rss.xml">
        <Icon name="feed" size={16} />
        RSS feed
      </a>
    </div>
  </header>

  <Band aria-label="Posts">
    <div class="posts">
      {posts.map((post) => (
        <a class="post" href={postPath(post)}>
          <div>
            <span class="when">
              {shortDate(post.data.date)} · {post.data.tag}
            </span>
            <h2>{post.data.title}</h2>
            <p>{post.data.summary}</p>
          </div>
          <Cover columns={post.data.cover} />
        </a>
      ))}
    </div>
  </Band>
  <Grow />
</Page>
