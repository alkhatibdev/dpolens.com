{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dpolens-com",
  "compatibility_date": "2026-10-21",
  // Static files only: no Worker code runs, so public/_headers applies to every response.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "dpolens.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
